{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bora-radar",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":["/api/*"]},
  "d1_databases": [{"binding":"DB","database_name":"bora-radar-db","database_id":"COLE_AQUI_O_ID_DO_NOVO_BANCO_D1","migrations_dir":"migrations"}],
  "vars": {"MONTHLY_CALL_LIMIT":"800","DAILY_CALL_LIMIT":"40"},
  "observability":{"enabled":false}
}
